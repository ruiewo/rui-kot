{
	"manifest_version": 3,
	"name": "Rui 勤怠自動入力",
	"version": "1.1.0",
	"description": "KING OF TIME / freee勤怠管理プラスの勤怠管理ページで、打刻を自動入力するChrome拡張機能",
	"permissions": ["storage", "activeTab"],
	"host_permissions": ["https://*.kingoftime.jp/admin/*", "https://kintaiplus.freee.co.jp/admin/*"],
	"content_scripts": [
		{
			"matches": ["https://*.kingoftime.jp/admin/*", "https://kintaiplus.freee.co.jp/admin/*"],
			"js": ["content.js"]
		}
	],
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}
